# Team trial/local shared database setup.
# Copy to .env.local and fill real secrets locally. Do NOT commit .env.local.

DATABASE_URL="paste-shared-trial-database-url-here?sslmode=require"
JWT_SECRET="replace-with-a-long-shared-team-trial-secret-at-least-32-chars"
SESSION_COOKIE_NAME="mall_session"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Trial/dev team mode: allow memory fallback when Redis is not configured.
# Production must use Redis and set this to true.
REDIS_REQUIRED="false"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

MEDIA_PROVIDER="local"
MEDIA_MAX_SIZE_MB="8"
LOCAL_UPLOAD_BASE_URL="/uploads"

ALLOW_PASSWORD_RESET_LINK_RESPONSE="true"
EMAIL_NOTIFICATIONS_ENABLED="false"
SMS_NOTIFICATIONS_ENABLED="false"

CRON_SECRET="replace-with-a-long-random-cron-secret"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional for team trial; required for real production.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
BACKUP_STORAGE_PROVIDER="local"
