# Production environment template — do not commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
JWT_SECRET="generate-with-openssl-rand-hex-32-or-longer"
SESSION_COOKIE_NAME="mall_session"
NEXT_PUBLIC_APP_URL="https://your-domain.example"
NEXT_PUBLIC_APP_ENV="production"
APP_ENV="production"
# Fail closed if a deployment accidentally uses Staging resources or a shared Redis namespace.
ENVIRONMENT_ISOLATION_ENFORCED="true"
RUNTIME_ENVIRONMENT="production"
RESOURCE_NAMESPACE="mall-os:production"
REDIS_KEY_PREFIX="mall-os:production:"
ENVIRONMENT_PUBLIC_HOST="your-domain.example"
PAYMENT_ENVIRONMENT="live"
ERP_ENVIRONMENT="live"
OUTBOUND_DELIVERY_MODE="live"

# Redis is required in production.
REDIS_REQUIRED="true"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Desktop Accounting / POS / ERP integration API.
# Prefer rows in integration_clients with token_hash=sha256(secret). Env fallback is supported for first setup.
INTEGRATION_API_KEYS=""
INTEGRATION_CLIENTS_JSON=""

# Cron protection is required in production.
CRON_SECRET="generate-a-long-random-cron-secret"
JOBS_PROCESS_LIMIT="50"
JOBS_LOOP_INTERVAL_MS="5000"

# Object storage/CDN is required in production: cloudinary | s3 | r2.
MEDIA_PROVIDER="cloudinary"
MEDIA_MAX_SIZE_MB="8"
NEXT_IMAGE_REMOTE_HOSTS="res.cloudinary.com"
# CSP production allowlists. Add only origins required by browser fetch/media.
CSP_CONNECT_SRC=""
CSP_IMG_SRC="res.cloudinary.com"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="production"
# Or S3/R2-compatible:
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Private legal documents (Cloudflare R2 private bucket; never expose a public base URL).
PRIVATE_DOCUMENTS_STORAGE_PROVIDER="r2"
PRIVATE_DOCUMENTS_R2_BUCKET=""
PRIVATE_DOCUMENTS_R2_ENDPOINT=""
PRIVATE_DOCUMENTS_R2_REGION="auto"
PRIVATE_DOCUMENTS_R2_ACCESS_KEY_ID=""
PRIVATE_DOCUMENTS_R2_SECRET_ACCESS_KEY=""
PRIVATE_DOCUMENTS_R2_PREFIX="production/legal-documents"
PRIVATE_DOCUMENTS_MAX_SIZE_MB="15"

# Monitoring.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
SENTRY_REPLAY_ERROR_SAMPLE_RATE="0.1"
UPTIME_WEBHOOK_URL=""
LOG_DRAIN_URL=""
PROMETHEUS_PUSHGATEWAY_URL=""
METRICS_EXPORT_ENABLED="true"
METRICS_TOKEN="generate-a-long-random-metrics-token"
MONITORING_REQUEST_SAMPLE_RATE="1"
GRAFANA_URL=""
GRAFANA_DASHBOARD_URL=""
GRAFANA_CLOUD_API_KEY=""

# Payment providers.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Server-only local gateway configuration; do not put these values in paymentMethods.config.
LOCAL_GATEWAY_API_URL=""
LOCAL_GATEWAY_REFUND_URL=""
LOCAL_GATEWAY_AUTHORIZATION_HEADER="Authorization"
LOCAL_GATEWAY_MERCHANT_ID=""
LOCAL_GATEWAY_WEBHOOK_SECRET=""
PAYMENT_PROVIDER_API_KEY=""

# Transactional outbound messages.
EMAIL_NOTIFICATIONS_ENABLED="true"
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
# HTTPS delivery deadline for Email/SMS/WhatsApp webhook requests.
OUTBOUND_WEBHOOK_TIMEOUT_MS="10000"
ALERT_EMAIL_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
SMS_NOTIFICATIONS_ENABLED="true"
SMS_WEBHOOK_ENABLED="true"
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
WHATSAPP_WEBHOOK_ENABLED="true"
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""

# Backups / restore drills.
# Durable encrypted backups. Production requires s3 or r2, never local /tmp.
BACKUP_STORAGE_PROVIDER="s3"
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_PREFIX="production/database"
BACKUP_S3_KMS_KEY_ID=""
# Enable physical media copies; list only trusted media/CDN hostnames.
BACKUP_MEDIA_ENABLED="true"
BACKUP_MEDIA_SOURCE_HOSTS=""
BACKUP_MEDIA_PREFIX="media"
BACKUP_MEDIA_MAX_FILES="500"
BACKUP_MEDIA_MAX_BYTES="26214400"
# Dedicated already-migrated database used only by backup:recovery-test.
RECOVERY_TEST_DATABASE_URL=""
RECOVERY_TEST_CONFIRM="false"
# Destructive restore requires maintenance mode + independent operator token.
BACKUP_RESTORE_MAINTENANCE_MODE="false"
BACKUP_RESTORE_APPROVAL_TOKEN=""

# Password reset.
ALLOW_PASSWORD_RESET_LINK_RESPONSE="false"

# OAuth optional.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.example/api/auth/google/callback"

# Contract lifecycle.
DEFAULT_CONTRACT_DAYS="365"
DEFAULT_CONTRACT_ALERT_DAYS="30"

# Strict fail-closed runtime safeguards for real launch.
PRODUCTION_LAUNCH_MODE="true"

# DB pooler / PgBouncer / managed pooler settings.
# Use the provider's pooled connection URL in DATABASE_URL and keep per-instance max low on serverless.
DATABASE_POOLER_ENABLED="true"
DB_POOL_MAX="3"
POSTGRES_POOL_MAX="3"
DB_IDLE_TIMEOUT_SECONDS="20"
DB_CONNECT_TIMEOUT_SECONDS="10"
DB_APPLICATION_NAME="salahsentar22-production"
# Public homepage read budget. On a slow DB/cache miss the app serves a safe fallback instead of a 504.
HOME_DATA_TIMEOUT_MS="5000"

# Search analytics should be sampled in production to avoid write amplification under load.
# Sponsored-ad measurement controls (per campaign / visitor / UTC day)
AD_IMPRESSION_FREQUENCY_CAP="3"

SEARCH_ANALYTICS_SAMPLE_RATE="0.05"
# Auto Scaling Intelligence control plane
AUTO_SCALING_AUTOPILOT="false"
AUTO_SCALING_MIN_API_INSTANCES="1"
AUTO_SCALING_MAX_API_INSTANCES="8"
AUTO_SCALING_MIN_QUEUE_WORKERS="1"
AUTO_SCALING_MAX_QUEUE_WORKERS="6"
AUTO_SCALING_MIN_WORKER_BATCH="10"
AUTO_SCALING_MAX_WORKER_BATCH="100"
AUTO_SCALING_CPU_SCALE_OUT="70"
AUTO_SCALING_CPU_EMERGENCY="90"
AUTO_SCALING_MEMORY_SCALE_OUT="78"
AUTO_SCALING_MEMORY_EMERGENCY="90"
AUTO_SCALING_QUEUE_SCALE_OUT="50"
AUTO_SCALING_QUEUE_EMERGENCY="300"
AUTO_SCALING_RESPONSE_SCALE_OUT_MS="1200"
AUTO_SCALING_RESPONSE_EMERGENCY_MS="3000"
SCALING_CONTROLLER_WEBHOOK_URL=""
SCALING_CONTROLLER_WEBHOOK_TOKEN=""

# Alternative Cloudinary single URL. Prefer Vercel encrypted env; never commit real value.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Keep customer order money merchant-direct at launch. Do not change without an approved financial-intermediary programme.
PLATFORM_CUSTOMER_MONEY_MODE="merchant_collects"
