# PostgreSQL connection string. Render example:
# postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:5432/marketplace"

# Required JWT secret: application auth fails if empty. Use a long random value in every environment.
JWT_SECRET="replace-with-a-64-char-random-secret-generated-by-openssl-rand-hex-32"
SESSION_COOKIE_NAME="mall_session"

# Public app URL for redirects and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: media CDN base URL if you add an uploader later.
NEXT_PUBLIC_CDN_URL=""

# First-admin bootstrap only. `npm run db:seed` NEVER creates user accounts.
# Set these only in a secure shell immediately before `npm run admin:bootstrap`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
ALLOW_ADMIN_BOOTSTRAP="false"

# Redis infrastructure. Required in production/serverless for rate limiting, public cache,
# idempotency and distributed coordination. Upstash REST / Vercel KV REST are supported.
REDIS_REQUIRED="true"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional compatible aliases:
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Media uploads: local | cloudinary | s3 | r2
MEDIA_PROVIDER="local"
MEDIA_MAX_SIZE_MB="8"
MALWARE_SCAN_WEBHOOK_URL=""
MALWARE_SCAN_TOKEN=""

# Local development upload base URL
LOCAL_UPLOAD_BASE_URL="/uploads"

# Cloudinary signed upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="marketplace"

# S3/R2-compatible storage
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
# Private legal documents. Local fallback is development-only; production requires R2.
PRIVATE_DOCUMENTS_STORAGE_PROVIDER="local"
PRIVATE_DOCUMENTS_R2_BUCKET=""
PRIVATE_DOCUMENTS_R2_ENDPOINT=""
PRIVATE_DOCUMENTS_R2_REGION="auto"
PRIVATE_DOCUMENTS_R2_ACCESS_KEY_ID=""
PRIVATE_DOCUMENTS_R2_SECRET_ACCESS_KEY=""
PRIVATE_DOCUMENTS_R2_PREFIX="legal-documents"
PRIVATE_DOCUMENTS_MAX_SIZE_MB="15"

# Google OAuth login (اختياري). أنشئ Web application OAuth client في Google Cloud.
# يجب أن يطابق GOOGLE_REDIRECT_URI حرفياً Authorized redirect URI في Google Console.
# مثال production: https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Password reset behavior
# في الإنتاج يفضل تفعيل البريد. لا تُظهر رابط الاستعادة في الاستجابة إلا مؤقتاً عند الحاجة.
ALLOW_PASSWORD_RESET_LINK_RESPONSE="false"

# Optional outbound messages after final approval and password reset
EMAIL_NOTIFICATIONS_ENABLED="false"
SMS_NOTIFICATIONS_ENABLED="false"

# Comma-separated HTTPS hostnames allowed by Next Image Optimizer, no wildcards.
NEXT_IMAGE_REMOTE_HOSTS="res.cloudinary.com"
# Production CSP allowlists; local development keeps a wider policy for tooling.
CSP_CONNECT_SRC=""
CSP_IMG_SRC="res.cloudinary.com"

# Desktop Accounting / POS / ERP integration API
# Preferred: create clients in integration_clients with sha256 token hashes.
# Environment fallback examples:
# INTEGRATION_API_KEYS="agent-1:local-secret:*:*"
# INTEGRATION_CLIENTS_JSON='[{"clientId":"agent-1","token":"local-secret","storeIds":[],"scopes":["*"]}]'
INTEGRATION_API_KEYS=""
INTEGRATION_CLIENTS_JSON=""

# Background jobs / cron
# Use /api/cron/jobs/process with Authorization: Bearer CRON_SECRET, or run npm run jobs:worker on a worker host.
JOBS_PROCESS_LIMIT="25"
JOBS_LOOP_INTERVAL_MS="5000"

# Payment gateways
# manual providers work without secrets. Stripe requires these values and a supported order currency.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
LOCAL_PAYMENT_WEBHOOK_SECRET=""

# Outbound notifications webhooks (optional)
SMS_WEBHOOK_ENABLED="false"
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
WHATSAPP_WEBHOOK_ENABLED="false"
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
# HTTPS delivery deadline for Email/SMS/WhatsApp webhook requests.
OUTBOUND_WEBHOOK_TIMEOUT_MS="10000"
ALERT_EMAIL_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Contract lifecycle defaults
DEFAULT_CONTRACT_DAYS="365"
DEFAULT_CONTRACT_ALERT_DAYS="30"
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Production monitoring (optional locally, required before public launch)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
NEXT_PUBLIC_APP_ENV="development"
APP_ENV="development"
# Environment-isolation contract. Keep false only for local development.
# Staging/Production must set this true and use unique provider resources.
ENVIRONMENT_ISOLATION_ENFORCED="false"
RUNTIME_ENVIRONMENT="development"
RESOURCE_NAMESPACE="mall-os:development"
REDIS_KEY_PREFIX="mall-os:development:"
ENVIRONMENT_PUBLIC_HOST="localhost:3000"
PAYMENT_ENVIRONMENT="sandbox"
ERP_ENVIRONMENT="sandbox"
OUTBOUND_DELIVERY_MODE="disabled"
UPTIME_WEBHOOK_URL=""
LOG_DRAIN_URL=""
PROMETHEUS_PUSHGATEWAY_URL=""
METRICS_EXPORT_ENABLED="false"
METRICS_TOKEN=""
MONITORING_REQUEST_SAMPLE_RATE="1"
GRAFANA_URL=""
GRAFANA_DASHBOARD_URL=""
GRAFANA_CLOUD_API_KEY=""

# Backup storage. Local is only for development; production requires s3 or r2.
BACKUP_STORAGE_PROVIDER="local"
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_PREFIX="database"
BACKUP_S3_KMS_KEY_ID=""
BACKUP_MEDIA_ENABLED="false"
BACKUP_MEDIA_SOURCE_HOSTS=""
BACKUP_MEDIA_PREFIX="media"
BACKUP_MEDIA_MAX_FILES="500"
BACKUP_MEDIA_MAX_BYTES="26214400"
RECOVERY_TEST_DATABASE_URL=""
# Recovery drills are Staging-only and require an intentionally initialized target.
RECOVERY_TEST_ENVIRONMENT=""
RECOVERY_TARGET_LABEL=""
RECOVERY_TARGET_INITIALIZE_CONFIRM="false"
RECOVERY_TEST_CONFIRM="false"
RECOVERY_RECORD_RELEASE_EVIDENCE="false"

# Local payment gateway — server-only. Never store these values in paymentMethods.config.
LOCAL_GATEWAY_API_URL=""
LOCAL_GATEWAY_REFUND_URL=""
LOCAL_GATEWAY_AUTHORIZATION_HEADER="Authorization"
LOCAL_GATEWAY_MERCHANT_ID=""
LOCAL_GATEWAY_WEBHOOK_SECRET=""
PAYMENT_PROVIDER_API_KEY=""

# Launch hardening controls
PRODUCTION_LAUNCH_MODE="false"
DATABASE_POOLER_ENABLED="false"
DB_POOL_MAX="10"
DB_IDLE_TIMEOUT_SECONDS="20"
DB_CONNECT_TIMEOUT_SECONDS="10"
# Public homepage DB/cache-miss budget in milliseconds; fallback is served on timeout.
HOME_DATA_TIMEOUT_MS="5000"
# Sponsored-ad measurement controls (per campaign / visitor / UTC day)
AD_IMPRESSION_FREQUENCY_CAP="3"

SEARCH_ANALYTICS_SAMPLE_RATE="1"

# QA fixtures — Local/Staging only. Never set these in Production.
TEST_FIXTURES_CONFIRM="false"
TEST_FIXTURES_RESET_PASSWORDS="false"
TEST_ADMIN_EMAIL=""
TEST_ADMIN_NAME=""
TEST_ADMIN_PASSWORD=""
TEST_ADMIN_2_EMAIL=""
TEST_ADMIN_2_NAME=""
TEST_ADMIN_2_PASSWORD=""
TEST_MERCHANT_EMAIL=""
TEST_MERCHANT_NAME=""
TEST_MERCHANT_PASSWORD=""
TEST_MERCHANT_2_EMAIL=""
TEST_MERCHANT_2_NAME=""
TEST_MERCHANT_2_PASSWORD=""
TEST_CUSTOMER_EMAIL=""
TEST_CUSTOMER_NAME=""
TEST_CUSTOMER_PASSWORD=""
TEST_CUSTOMER_2_EMAIL=""
TEST_CUSTOMER_2_NAME=""
TEST_CUSTOMER_2_PASSWORD=""
TEST_FIXTURES_STORE_SLUG="qa-local-store"

# Minimal local/Staging test experience. Creates one test merchant, a real wing/store,
# and a draft product at price=0 and stock=0. Never use in Production.
TEST_EXPERIENCE_CONFIRM=""
TEST_EXPERIENCE_MERCHANT_EMAIL=""
TEST_EXPERIENCE_MERCHANT_NAME=""
TEST_EXPERIENCE_MERCHANT_PASSWORD=""
TEST_EXPERIENCE_STORE_SLUG="test-experience-store"
TEST_EXPERIENCE_WING_SLUG="test-experience-wing"

# Auto Scaling Intelligence control plane
AUTO_SCALING_AUTOPILOT="false"
AUTO_SCALING_MIN_API_INSTANCES="1"
AUTO_SCALING_MAX_API_INSTANCES="8"
AUTO_SCALING_MIN_QUEUE_WORKERS="1"
AUTO_SCALING_MAX_QUEUE_WORKERS="6"
AUTO_SCALING_MIN_WORKER_BATCH="10"
AUTO_SCALING_MAX_WORKER_BATCH="100"
AUTO_SCALING_CPU_SCALE_OUT="70"
AUTO_SCALING_CPU_EMERGENCY="90"
AUTO_SCALING_MEMORY_SCALE_OUT="78"
AUTO_SCALING_MEMORY_EMERGENCY="90"
AUTO_SCALING_QUEUE_SCALE_OUT="50"
AUTO_SCALING_QUEUE_EMERGENCY="300"
AUTO_SCALING_RESPONSE_SCALE_OUT_MS="1200"
AUTO_SCALING_RESPONSE_EMERGENCY_MS="3000"
SCALING_CONTROLLER_WEBHOOK_URL=""
SCALING_CONTROLLER_WEBHOOK_TOKEN=""

# Commercial money-flow policy. Default is merchant_collects: customer order money goes directly to merchant.
# platform_settlement is prohibited unless a separate governance, legal and payment-provider approval is completed.
PLATFORM_CUSTOMER_MONEY_MODE="merchant_collects"
