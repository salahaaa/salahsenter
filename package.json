{
  "name": "enterprise-multi-vendor-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "node --max-old-space-size=1400 ./node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test:fixtures": "tsx scripts/create-test-fixtures.ts",
    "test:experience:bootstrap": "tsx scripts/bootstrap-test-experience.ts",
    "staging:test-team:provision": "tsx scripts/provision-staging-test-team.ts",
    "environment:verify": "tsx scripts/verify-environment-isolation.ts",
    "migrations:verify": "node scripts/verify-migration-journal.mjs",
    "security:secrets": "node scripts/security/verify-no-secrets.mjs",
    "security:verify": "npm run security:secrets && npm run security:admin-guards && npm audit --omit=dev --audit-level=high",
    "check:paths": "node scripts/check-ascii-paths.mjs",
    "check:import-case": "node scripts/check-import-path-casing.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:platform": "bash scripts/e2e/run-platform-full-cycle-smoke.sh",
    "test:e2e:http": "node scripts/full-test.js",
    "test:e2e:playwright": "playwright test",
    "test:staging:lighthouse": "node scripts/lighthouse/run-staging-audit.mjs",
    "import:aratat-demo": "tsx scripts/import-aratat-demo-store.ts",
    "updates:last24": "node scripts/export-recent-updates.mjs --hours=24 --out=updates",
    "updates:since": "node scripts/export-recent-updates.mjs --out=updates",
    "jobs:process": "tsx scripts/process-jobs.ts",
    "jobs:worker": "tsx scripts/process-jobs.ts --loop",
    "production:readiness": "tsx scripts/production-readiness-check.ts",
    "security:deployment-gate": "tsx scripts/security-deployment-gate.ts",
    "media:inline-audit": "tsx scripts/media/inline-media-maintenance.ts --audit",
    "media:inline-export": "tsx scripts/media/inline-media-maintenance.ts --export",
    "media:inline-migrate": "tsx scripts/media/inline-media-maintenance.ts --migrate",
    "backup:json": "tsx scripts/backup/create-json-backup.ts",
    "backup:recovery:init-target": "tsx scripts/backup/initialize-recovery-target.ts",
    "backup:recovery-test": "tsx scripts/backup/recovery-test.ts",
    "launch:check": "npm run typecheck && npm run lint && npm test && npm audit --omit=dev --audit-level=high && npm run build",
    "load:probe": "node scripts/load/staging-http-probe.mjs",
    "load:security-center": "node scripts/load/security-center-probe.mjs",
    "reliability:verify": "tsx scripts/verify-distributed-consistency.ts",
    "media:audit-redact": "tsx scripts/media/redact-inline-media-audit-logs.ts",
    "a11y:audit": "node scripts/audit-ui-accessibility.mjs",
    "performance:bundle": "node scripts/performance/check-bundle-budget.mjs",
    "import:ui-fixtures": "tsx scripts/import-ui-inspiration-fixtures.ts",
    "enrich:product-options": "tsx scripts/enrich-store-product-options.ts",
    "security:admin-guards": "node scripts/security/check-admin-route-guards.mjs",
    "check:client-boundaries": "node scripts/check-client-server-boundaries.mjs",
    "release:package-verify": "node scripts/verify-release-package.mjs",
    "update:channel:verify": "node tools/verify-update-channel.mjs",
    "release:verify:source": "npm run check:paths && npm run check:import-case && npm run check:client-boundaries && npm run release:package-verify && npm run update:channel:verify && npm run lint && npm run typecheck && npm test && npm run migrations:verify && npx drizzle-kit check --config=drizzle.config.ts && npm run security:verify && npm audit --audit-level=high && git diff --check",
    "release:verify": "npm run release:verify:source && npm run build && npm run performance:bundle"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.59.0",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "^15.5.21",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "^1.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "lighthouse": "^13.4.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "next": {
      "postcss": "8.5.23"
    },
    "uuid": "11.1.1",
    "minimatch@3.1.5": {
      "brace-expansion": "5.0.8"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "5.0.8"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "js-yaml": "4.3.0",
    "fast-uri": "4.1.1",
    "sharp": "0.35.3",
    "postcss": "8.5.23",
    "archiver": "8.0.0"
  },
  "engines": {
    "node": ">=22.19 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10"
}
