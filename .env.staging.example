# Staging runtime template — never commit real secrets.
# This environment must use resources that are separate from Development and Production.
DATABASE_URL="postgresql://USER:PASSWORD@STAGING-POOLED-HOST/DB?sslmode=require"
JWT_SECRET="generate-a-unique-staging-secret-at-least-32-characters"
SESSION_COOKIE_NAME="mall_staging_session"
NEXT_PUBLIC_APP_URL="https://staging.your-domain.example"
NEXT_PUBLIC_APP_ENV="staging"
APP_ENV="staging"

# Fail closed if an operator omits the resource namespace or mixes a Production provider resource.
ENVIRONMENT_ISOLATION_ENFORCED="true"
RUNTIME_ENVIRONMENT="staging"
RESOURCE_NAMESPACE="mall-os:staging"
REDIS_KEY_PREFIX="mall-os:staging:"
ENVIRONMENT_PUBLIC_HOST="staging.your-domain.example"
PAYMENT_ENVIRONMENT="sandbox"
ERP_ENVIRONMENT="sandbox"
OUTBOUND_DELIVERY_MODE="sandbox"

# Dedicated Staging Redis/Upstash database — never reuse Production credentials.
REDIS_REQUIRED="true"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public media: a separate Cloudinary product is strongest. A dedicated staging/ folder is the minimum boundary.
MEDIA_PROVIDER="cloudinary"
MEDIA_MAX_SIZE_MB="8"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="staging"
NEXT_IMAGE_REMOTE_HOSTS="res.cloudinary.com"
CSP_IMG_SRC="res.cloudinary.com"
CSP_CONNECT_SRC=""

# Private legal documents: private Staging R2 bucket and environment prefix only.
PRIVATE_DOCUMENTS_STORAGE_PROVIDER="r2"
PRIVATE_DOCUMENTS_R2_BUCKET="mall-os-staging-private-documents"
PRIVATE_DOCUMENTS_R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
PRIVATE_DOCUMENTS_R2_REGION="auto"
PRIVATE_DOCUMENTS_R2_ACCESS_KEY_ID=""
PRIVATE_DOCUMENTS_R2_SECRET_ACCESS_KEY=""
PRIVATE_DOCUMENTS_R2_PREFIX="staging/legal-documents"
PRIVATE_DOCUMENTS_MAX_SIZE_MB="15"

# Separate Staging R2 backup bucket. Variables retain BACKUP_S3_* naming because the client is S3-compatible.
BACKUP_STORAGE_PROVIDER="r2"
BACKUP_S3_BUCKET="mall-os-staging-backups"
BACKUP_S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
BACKUP_S3_REGION="auto"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_PREFIX="staging/database"
BACKUP_MEDIA_ENABLED="false"
RECOVERY_TEST_DATABASE_URL="postgresql://USER:PASSWORD@STAGING-RECOVERY-DIRECT-HOST/DB?sslmode=require"
RECOVERY_TEST_ENVIRONMENT="staging"
RECOVERY_TARGET_LABEL="staging-recovery-db"
RECOVERY_TARGET_INITIALIZE_CONFIRM="false"
RECOVERY_TEST_CONFIRM="false"
RECOVERY_RECORD_RELEASE_EVIDENCE="false"

# Sandbox payments only. Do not configure live Stripe/local-gateway credentials in Staging.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
LOCAL_GATEWAY_API_URL=""
LOCAL_GATEWAY_REFUND_URL=""
LOCAL_GATEWAY_AUTHORIZATION_HEADER="Authorization"
LOCAL_GATEWAY_MERCHANT_ID=""
LOCAL_GATEWAY_WEBHOOK_SECRET=""
PAYMENT_PROVIDER_API_KEY=""

# Sandbox-only notifications. Use a mail/SMS test sink or an allowlisted test relay.
EMAIL_NOTIFICATIONS_ENABLED="true"
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
SMS_NOTIFICATIONS_ENABLED="true"
SMS_WEBHOOK_ENABLED="true"
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
OUTBOUND_WEBHOOK_TIMEOUT_MS="10000"

# ERP test tenant/sandbox only. Do not place Production agent keys here.
INTEGRATION_API_KEYS=""
INTEGRATION_CLIENTS_JSON=""

# OAuth and jobs must return to the Staging domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://staging.your-domain.example/api/auth/google/callback"
CRON_SECRET="generate-a-unique-staging-cron-secret"
JOBS_PROCESS_LIMIT="25"
JOBS_LOOP_INTERVAL_MS="5000"

# Observability for Staging is isolated from Production alerts/projects.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
UPTIME_WEBHOOK_URL=""
LOG_DRAIN_URL=""

# Serverless database protection.
DATABASE_POOLER_ENABLED="true"
DB_POOL_MAX="3"
POSTGRES_POOL_MAX="3"
DB_IDLE_TIMEOUT_SECONDS="20"
DB_CONNECT_TIMEOUT_SECONDS="10"
DB_APPLICATION_NAME="salahsentar22-staging"
HOME_DATA_TIMEOUT_MS="5000"
PRODUCTION_LAUNCH_MODE="false"
PLATFORM_CUSTOMER_MONEY_MODE="merchant_collects"
